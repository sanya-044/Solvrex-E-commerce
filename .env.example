# Copy this file to .env.local and replace the placeholder with your MongoDB connection string.
MONGODB_URI=

# Optional: required for Google sign-in and secure admin authentication.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: required for payment checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
